      "source": [
        "import copy\n",
        "\n",
        "# Variáveis para representar os estados do tabuleiro\n",
        "X = \"X\"\n",
        "O = \"O\"\n",
        "EMPTY = None\n",
        "\n",
        "def initial_state():\n",
        "    \"\"\"\n",
        "    Retorna o estado inicial do tabuleiro.\n",
        "    \"\"\"\n",
        "    return [[EMPTY, EMPTY, EMPTY],\n",
        "            [EMPTY, EMPTY, EMPTY],\n",
        "            [EMPTY, EMPTY, EMPTY]]\n",
        "\n",
        "def player(board):\n",
        "    \"\"\"\n",
        "    Retorna o jogador que tem a próxima vez no tabuleiro (X ou O).\n",
        "    X sempre começa.\n",
        "    \"\"\"\n",
        "    x_count = sum(row.count(X) for row in board)\n",
        "    o_count = sum(row.count(O) for row in board)\n",
        "\n",
        "    if x_count == o_count:\n",
        "        return X\n",
        "    else:\n",
        "        return O\n",
        "\n",
        "def actions(board):\n",
        "    \"\"\"\n",
        "    Retorna um conjunto de todas as ações possíveis (i, j) disponíveis no tabuleiro.\n",
        "    Uma ação é uma tupla (linha, coluna) de uma célula vazia.\n",
        "    \"\"\"\n",
        "    possible_actions = set()\n",
        "    for i in range(3):\n",
        "        for j in range(3):\n",
        "            if board[i][j] == EMPTY:\n",
        "                possible_actions.add((i, j))\n",
        "    return possible_actions\n",
        "\n",
        "def result(board, action):\n",
        "    \"\"\"\n",
        "    Retorna o tabuleiro que resulta de fazer o movimento (i, j) no tabuleiro.\n",
        "    Cria uma nova cópia profunda do tabuleiro para não modificar o original.\n",
        "    Levanta uma exceção se a ação não for válida.\n",
        "    \"\"\"\n",
        "    if action not in actions(board):\n",
        "        raise Exception(\"Ação inválida\")\n",
        "\n",
        "    new_board = copy.deepcopy(board)\n",
        "    current_player = player(board)\n",
        "    new_board[action[0]][action[1]] = current_player\n",
        "    return new_board\n",
        "\n",
        "def winner(board):\n",
        "    \"\"\"\n",
        "    Retorna o vencedor do jogo, se houver.\n",
        "    Retorna X se X ganhou, O se O ganhou, e None caso contrário.\n",
        "    \"\"\"\n",
        "    # Verificar linhas\n",
        "    for row in board:\n",
        "        if row[0] == row[1] == row[2] and row[0] != EMPTY:\n",
        "            return row[0]\n",
        "\n",
        "    # Verificar colunas\n",
        "    for col in range(3):\n",
        "        if board[0][col] == board[1][col] == board[2][col] and board[0][col] != EMPTY:\n",
        "            return board[0][col]\n",
        "\n",
        "    # Verificar diagonais\n",
        "    if board[0][0] == board[1][1] == board[2][2] and board[0][0] != EMPTY:\n",
        "        return board[0][0]\n",
        "    if board[0][2] == board[1][1] == board[2][0] and board[0][2] != EMPTY:\n",
        "        return board[0][2]\n",
        "\n",
        "    return None\n",
        "\n",
        "def terminal(board):\n",
        "    \"\"\"\n",
        "    Retorna True se o jogo terminou, False caso contrário.\n",
        "    O jogo termina se há um vencedor ou se o tabuleiro está cheio.\n",
        "    \"\"\"\n",
        "    if winner(board) is not None:\n",
        "        return True\n",
        "    # Verifica se todas as células estão preenchidas\n",
        "    if all(cell != EMPTY for row in board for cell in row):\n",
        "        return True\n",
        "    return False\n",
        "\n",
        "def utility(board):\n",
        "    \"\"\"\n",
        "    Retorna o valor de utilidade do tabuleiro terminal.\n",
        "    1 se X ganhou, -1 se O ganhou, 0 se é um empate.\n",
        "    \"\"\"\n",
        "    game_winner = winner(board)\n",
        "    if game_winner == X:\n",
        "        return 1\n",
        "    elif game_winner == O:\n",
        "        return -1\n",
        "    else:\n",
        "        return 0\n",
        "\n",
        "def minimax(board):\n",
        "    \"\"\"\n",
        "    Retorna a ação ideal para o jogador atual no tabuleiro.\n",
        "    Se o tabuleiro for terminal, retorna None.\n",
        "    \"\"\"\n",
        "    if terminal(board):\n",
        "        return None\n",
        "\n",
        "    current_player = player(board)\n",
        "\n",
        "    if current_player == X:\n",
        "        # X é o jogador maximizador\n",
        "        v = -float('inf')\n",
        "        best_action = None\n",
        "        for action in actions(board):\n",
        "            # Chama min_value para o estado resultante\n",
        "            new_v = min_value(result(board, action))\n",
        "            if new_v > v:\n",
        "                v = new_v\n",
        "                best_action = action\n",
        "        return best_action\n",
        "    else:\n",
        "        # O é o jogador minimizador\n",
        "        v = float('inf')\n",
        "        best_action = None\n",
        "        for action in actions(board):\n",
        "            # Chama max_value para o estado resultante\n",
        "            new_v = max_value(result(board, action))\n",
        "            if new_v < v:\n",
        "                v = new_v\n",
        "                best_action = action\n",
        "        return best_action\n",
        "\n",
        "def max_value(board):\n",
        "    \"\"\"\n",
        "    Função auxiliar para minimax. Retorna o valor de utilidade máximo para X.\n",
        "    \"\"\"\n",
        "    if terminal(board):\n",
        "        return utility(board)\n",
        "\n",
        "    v = -float('inf')\n",
        "    for action in actions(board):\n",
        "        v = max(v, min_value(result(board, action)))\n",
        "    return v\n",
        "\n",
        "def min_value(board):\n",
        "    \"\"\"\n",
        "    Função auxiliar para minimax. Retorna o valor de utilidade mínimo para O.\n",
        "    \"\"\"\n",
        "    if terminal(board):\n",
        "        return utility(board)\n",
        "\n",
        "    v = float('inf')\n",
        "    for action in actions(board):\n",
        "        v = min(v, max_value(result(board, action)))\n",
        "    return v"
